# Settings for the scripts. Copy to .env (git ignores it) and fill in. Variables already set in
# your environment take precedence over .env. One KEY=value per line; quotes are optional.

# The account to deploy to; deploy.sh and preflight.sh check your credentials resolve to it.
DEPLOY_ACCOUNT=
DEPLOY_REGION=us-east-1
# The VPC's two Availability Zones; the Trainium host goes in the first (or DEPLOY_TRAINIUM_AZ).
# trn1.2xlarge is offered only in some zones, and zone names differ by account; list yours:
#   aws ec2 describe-instance-type-offerings --location-type availability-zone \
#     --filters Name=instance-type,Values=trn1.2xlarge --query 'InstanceTypeOfferings[].Location'
# Keep them the same on every deploy: changing them replaces the VPC's subnets.
DEPLOY_AZS=
# DEPLOY_TRAINIUM_AZ=
# The Trainium host's AMI. Unset, deploy.sh keeps the running host's AMI (the newest DLAMI on the
# first deploy); `latest` takes the newest DLAMI, which replaces the host and deletes its volume.
# DEPLOY_TRAINIUM_AMI=
# AWS CLI profile, if not your default credentials.
# AWS_PROFILE=<profile>
# Optional tags on every resource, such as tags your account's policies require.
# DEPLOY_TAGS=Key1=value1,Key2=value2
