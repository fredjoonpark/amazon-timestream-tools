    {
      "type": "timeseries",
      "title": "Held-out quality: generated SQL exact match (Trainium) or execution accuracy (simulated)",
      "description": "Real Trainium: exact match of generated SQL on unseen questions. Simulated: held-out execution accuracy. These are different measures; the Runs filter selects the source.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT time, scenario, coalesce(gen_exact_match, exec_accuracy) AS accuracy FROM eval WHERE (gen_exact_match IS NOT NULL OR exec_accuracy IS NOT NULL) AND $__timeFilter(time) AND $source AND run_id LIKE '${run}' AND scenario IN ('healthy', 'trn_healthy') ORDER BY time",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "scenario"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 8,
            "spanNulls": false,
            "insertNulls": 120000
          },
          "displayName": "${__field.labels.scenario}",
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "Held-out evaluations appear as training progresses"
